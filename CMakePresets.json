{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64-clang",
      "displayName": "Windows x64 (Visual Studio + ClangCL)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "ClangCL",
      "binaryDir": "${sourceDir}/build/x64-clang",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64-clang-asan",
      "displayName": "Windows x64 ClangCL + AddressSanitizer (tests and fuzzing)",
      "inherits": "windows-x64-clang",
      "binaryDir": "${sourceDir}/build/x64-clang-asan",
      "cacheVariables": { "PASCALJUCE_SANITIZE": "address" }
    },

    {
      "name": "unix-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "unix-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x86_64 (GCC or Clang, Ninja)",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-x64"
    },
    {
      "name": "linux-x64-asan",
      "displayName": "Linux x86_64 + AddressSanitizer (tests and fuzzing)",
      "inherits": "linux-x64",
      "binaryDir": "${sourceDir}/build/linux-x64-asan",
      "cacheVariables": { "PASCALJUCE_SANITIZE": "address" }
    },
    {
      "name": "linux-x64-ubsan",
      "displayName": "Linux x86_64 + UndefinedBehaviorSanitizer",
      "inherits": "linux-x64",
      "binaryDir": "${sourceDir}/build/linux-x64-ubsan",
      "cacheVariables": { "PASCALJUCE_SANITIZE": "undefined" }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux arm64, e.g. Raspberry Pi 5 with 64-bit Raspberry Pi OS (Ninja)",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-arm64"
    },
    {
      "name": "linux-arm64-asan",
      "displayName": "Linux arm64 + AddressSanitizer",
      "inherits": "linux-arm64",
      "binaryDir": "${sourceDir}/build/linux-arm64-asan",
      "cacheVariables": { "PASCALJUCE_SANITIZE": "address" }
    },
    {
      "name": "linux-arm64-ubsan",
      "displayName": "Linux arm64 + UndefinedBehaviorSanitizer",
      "inherits": "linux-arm64",
      "binaryDir": "${sourceDir}/build/linux-arm64-ubsan",
      "cacheVariables": { "PASCALJUCE_SANITIZE": "undefined" }
    },

    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "unix-base",
      "cacheVariables": { "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos",
      "displayName": "macOS, this Mac's architecture (Xcode command line tools, Ninja)",
      "inherits": "macos-base",
      "binaryDir": "${sourceDir}/build/macos"
    },
    {
      "name": "macos-asan",
      "displayName": "macOS + AddressSanitizer",
      "inherits": "macos",
      "binaryDir": "${sourceDir}/build/macos-asan",
      "cacheVariables": { "PASCALJUCE_SANITIZE": "address" }
    },
    {
      "name": "macos-ubsan",
      "displayName": "macOS + UndefinedBehaviorSanitizer",
      "inherits": "macos",
      "binaryDir": "${sourceDir}/build/macos-ubsan",
      "cacheVariables": { "PASCALJUCE_SANITIZE": "undefined" }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon only (one half of a universal build)",
      "inherits": "macos-base",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" }
    },
    {
      "name": "macos-x86_64",
      "displayName": "macOS Intel only (one half of a universal build; needs FPC for x86_64-darwin)",
      "inherits": "macos-base",
      "binaryDir": "${sourceDir}/build/macos-x86_64",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-clang-release", "configurePreset": "windows-x64-clang", "configuration": "Release" },
    { "name": "windows-x64-clang-debug",   "configurePreset": "windows-x64-clang", "configuration": "Debug" },
    { "name": "windows-x64-clang-asan",    "configurePreset": "windows-x64-clang-asan", "configuration": "Release" },

    { "name": "linux-x64",         "configurePreset": "linux-x64" },
    { "name": "linux-x64-asan",    "configurePreset": "linux-x64-asan" },
    { "name": "linux-x64-ubsan",   "configurePreset": "linux-x64-ubsan" },
    { "name": "linux-arm64",       "configurePreset": "linux-arm64" },
    { "name": "linux-arm64-asan",  "configurePreset": "linux-arm64-asan" },
    { "name": "linux-arm64-ubsan", "configurePreset": "linux-arm64-ubsan" },
    { "name": "macos",             "configurePreset": "macos" },
    { "name": "macos-asan",        "configurePreset": "macos-asan" },
    { "name": "macos-ubsan",       "configurePreset": "macos-ubsan" },
    { "name": "macos-arm64",       "configurePreset": "macos-arm64" },
    { "name": "macos-x86_64",      "configurePreset": "macos-x86_64" }
  ],
  "testPresets": [
    {
      "name": "windows-x64-clang-release",
      "configurePreset": "windows-x64-clang",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-x64-clang-asan",
      "configurePreset": "windows-x64-clang-asan",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    { "name": "unix-test-base", "hidden": true, "output": { "outputOnFailure": true } },
    { "name": "linux-x64",         "inherits": "unix-test-base", "configurePreset": "linux-x64" },
    { "name": "linux-x64-asan",    "inherits": "unix-test-base", "configurePreset": "linux-x64-asan" },
    { "name": "linux-x64-ubsan",   "inherits": "unix-test-base", "configurePreset": "linux-x64-ubsan" },
    { "name": "linux-arm64",       "inherits": "unix-test-base", "configurePreset": "linux-arm64" },
    { "name": "linux-arm64-asan",  "inherits": "unix-test-base", "configurePreset": "linux-arm64-asan" },
    { "name": "linux-arm64-ubsan", "inherits": "unix-test-base", "configurePreset": "linux-arm64-ubsan" },
    { "name": "macos",             "inherits": "unix-test-base", "configurePreset": "macos" },
    { "name": "macos-asan",        "inherits": "unix-test-base", "configurePreset": "macos-asan" },
    { "name": "macos-ubsan",       "inherits": "unix-test-base", "configurePreset": "macos-ubsan" },
    { "name": "macos-arm64",       "inherits": "unix-test-base", "configurePreset": "macos-arm64" },
    { "name": "macos-x86_64",      "inherits": "unix-test-base", "configurePreset": "macos-x86_64" }
  ]
}

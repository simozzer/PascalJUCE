    object Accent: TJuceKnob
      Left = 13
      Height = 66
      Hint = 'ACCENT'#10'How much harder an accented hit strikes: velocity above 100 is an accent. It does not just turn the sound up - every circuit answers a taller trigger in its own way, a kick blooming, a snare cracking.'#10'MIDI CC 14. Right-click to learn another.'
      Top = 44
      Width = 66
      ParameterId = 'accent'
      DefaultValue = 0.5
      ShowValue = False
      Sensitivity = 180
      ArcColor = -640141013
      TrackColor = -16053492
      BodyColor = -13355974
      PointerColor = -2606805
      ValueBubble = jvbDragAndHover
    end

// Mz909 - an emulation of the TR-909 Rhythm Composer
// Created by Simon Moscrop
// Free software under the GNU AGPL v3; see LICENSE.
//
// Object Pascal port of Source/TR909/RomProfiles.h, converted from it mechanically (the
// same numbers, as Single constants).
//
// What the ROMs' stand-ins are made to sound like: a description of each sound, measured
// from recordings of a 909-style machine (a Behringer RD-9) and written down as numbers.
// No audio is kept - Roms.cpp (Tr909Roms) generates new sound from noise and sine waves
// and shapes it to these descriptions.
//
// Each profile is:
//  - seconds     how long the sample is
//  - times       the moments described, in seconds from the hit
//  - levels      at each moment, the energy in each of Roms.cpp's 18 bands, in dB re the
//                loudest; for the hihats, with the VCA's fall divided back out, so it is
//                the sample as it goes into the VCA
//  - onset       the first 40 ms, a millisecond at a time, in dB re 30-40 ms
//  - partials    steady pitches: hertz, and how far each stands above the noise round it
//                (dB) early, in the middle and late in the sound
//
// Generated by measuring; not meant to be edited by hand.
//

unit Tr909RomProfiles;

{$IFDEF FPC}
  {$MODE DELPHI}
{$ELSE}
  {$EXCESSPRECISION OFF}
{$ENDIF}

interface

const
  RomBandCount = 18;
  OnsetMs = 40;
  MaxProfileTimes = 64;
  MaxProfilePartials = 64;

type
  TRomPartial = record
    Hz: Single;
    Above: array[0..2] of Single;
  end;

  TBandLevels = array[0..RomBandCount - 1] of Single;

  TProfileTimes = array[0..MaxProfileTimes - 1] of Single;
  PProfileTimes = ^TProfileTimes;
  TProfileLevels = array[0..MaxProfileTimes - 1] of TBandLevels;
  PProfileLevels = ^TProfileLevels;
  TProfileOnset = array[0..OnsetMs - 1] of Single;
  PProfileOnset = ^TProfileOnset;
  TProfilePartials = array[0..MaxProfilePartials - 1] of TRomPartial;
  PProfilePartials = ^TProfilePartials;

  // The C++ RomProfile, its vectors as pointers to the tables below and their lengths.
  TRomProfile = record
    Seconds: Single;
    TimeCount: Integer;
    Times: PProfileTimes;          // TimeCount of them
    Levels: PProfileLevels;        // TimeCount rows
    Onset: PProfileOnset;
    PartialCount: Integer;
    Partials: PProfilePartials;    // PartialCount of them
  end;
  PRomProfile = ^TRomProfile;

function ClosedHatProfile: PRomProfile;
function OpenHatProfile: PRomProfile;
function CrashProfile: PRomProfile;
function RideProfile: PRomProfile;


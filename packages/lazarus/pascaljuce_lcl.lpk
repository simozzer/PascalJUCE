<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="pascaljuce_lcl"/>
    <Type Value="RunTime"/>
    <Author Value="PascalJUCE"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="../../pascal/design"/>
        <OtherUnitFiles Value="../../pascal;../../pascal/design"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="Delphi"/>
        </SyntaxOptions>
      </Parsing>
      <Other>
        <CustomOptions Value="-FcUTF8 -dPASCALJUCE_DESIGN"/>
      </Other>
    </CompilerOptions>
    <Description Value="PascalJUCE design-time controls (LCL): the plug-in editor controls as LCL controls that paint with the run-time painting code, plus the TCanvas back end and the run-time units they wrap. Required by pascaljuce_design (the IDE package) and by previews. Never use it in a plug-in."/>
    <License Value="See LICENSE in the PascalJUCE repository."/>
    <Version Major="0" Minor="2"/>
    <Files Count="10">
      <Item1>
        <Filename Value="../../pascal/JuceTypes.pas"/>
        <UnitName Value="JuceTypes"/>
      </Item1>
      <Item2>
        <Filename Value="../../pascal/JucePlugin.pas"/>
        <UnitName Value="JucePlugin"/>
      </Item2>
      <Item3>
        <Filename Value="../../pascal/JuceCanvas.pas"/>
        <UnitName Value="JuceCanvas"/>
      </Item3>
      <Item4>
        <Filename Value="../../pascal/JuceUI.pas"/>
        <UnitName Value="JuceUI"/>
      </Item4>
      <Item5>
        <Filename Value="../../pascal/JuceControls.pas"/>
        <UnitName Value="JuceControls"/>
      </Item5>
      <Item6>
        <Filename Value="../../pascal/JuceLayout.pas"/>
        <UnitName Value="JuceLayout"/>
      </Item6>
      <Item7>
        <Filename Value="../../pascal/design/JuceRaster.pas"/>
        <UnitName Value="JuceRaster"/>
      </Item7>
      <Item8>
        <Filename Value="../../pascal/design/JuceTCanvas.pas"/>
        <UnitName Value="JuceTCanvas"/>
      </Item8>
      <Item9>
        <Filename Value="../../pascal/design/JuceDesignControls.pas"/>
        <UnitName Value="JuceDesignControls"/>
      </Item9>
      <Item10>
        <Filename Value="../../pascal/design/JuceDesignGen.inc"/>
        <Type Value="Include"/>
      </Item10>
    </Files>
    <RequiredPkgs Count="1">
      <Item1>
        <PackageName Value="LCL"/>
      </Item1>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>

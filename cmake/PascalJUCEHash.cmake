# cmake -DLIBRARY=<file> -DOUTPUT=<header> -P PascalJUCEHash.cmake
# Writes the library's SHA-256 as a C header; touches the header only when
# the hash changes, so unrelated builds don't recompile the wrapper.
if(NOT EXISTS "${LIBRARY}")
    message(FATAL_ERROR "PascalJUCEHash: ${LIBRARY} does not exist")
endif()
file(SHA256 "${LIBRARY}" hash)
set(content "/* Generated by PascalJUCEHash.cmake - do not edit. */\n#define PASCALJUCE_PLUGIN_SHA256 \"${hash}\"\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL content)
        return()
    endif()
endif()
get_filename_component(dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${dir}")
file(WRITE "${OUTPUT}" "${content}")
